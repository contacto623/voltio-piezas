  },
  {
   "id": "e7",
   "tipo": "viaje",
   "dur": 12.85,
   "voz": {
    "texto": "Andrew Wiles lo conoció a los diez años. Lo anunció en mil novecientos noventa y tres, pero tenía un error. Con Richard Taylor lo arregló, y en mil novecientos noventa y cinco quedó publicado: trescientos cincuenta y ocho años después."
   },
   "params": {
    "titular": "El niño de",
    "destacado": "la biblioteca.",
    "hitos": [
     {
      "cuando": "1963",
      "texto": "A los *10 años* encuentra el problema en un libro."
     },
     {
      "cuando": "1993",
      "texto": "Lo anuncia en *Cambridge*."
     },
     {
      "cuando": "1993",
      "texto": "En la revisión aparece *un error*."
     },
     {
      "cuando": "1994",
      "texto": "Lo corrige con *Richard Taylor*."
     },
     {
      "cuando": "1995",
      "texto": "Se publica en *Annals of Mathematics*."
     }
    ],
    "bajada": "*358 años* después de la nota en el margen."
   },
   "palabrasClave": [

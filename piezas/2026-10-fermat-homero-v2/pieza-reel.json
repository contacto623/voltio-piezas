  {
   "id": "e5",
   "tipo": "manuscrito",
   "dur": 9,
   "voz": {
    "texto": "Hacia mil seiscientos treinta y siete, Fermat anotó en un margen: con potencias mayores que dos, nunca calza. Tenía una prueba maravillosa, pero no le cabía."
   },
   "params": {
    "titular": "Hacia 1637,",
    "destacado": "en un margen.",
    "estilo": "pergamino",
    "encabezado": "Arithmetica, libro II",
    "lineas": [
     {
      "texto": "Cubum autem in duos cubos, aut"
     },
     {
      "texto": "quadratoquadratum in duos quadra-"
     },
     {
      "texto": "toquadratos, et generaliter nullam"
     },
     {
      "texto": "in infinitum ultra quadratum potes-"
     },
     {
      "texto": "tatem in duos eiusdem nominis fas"
     },
     {

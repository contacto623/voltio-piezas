 "id": "preu-ajedrez-v2-cuaderno",
 "marca": "preu",
 "formato": "reel",
 "escenas": [
  {
   "id": "e1",
   "tipo": "gancho",
   "params": {
    "sello": "Leyenda de la India",
    "titular": "Pidió un grano de trigo",
    "destacado": "y el rey no pudo pagarle.",
    "dato": "64",
    "datoEtiqueta": "casillas del tablero",
    "bajada": "Y cada casilla *duplica* a la anterior.",
    "mundo": "si"
   },
   "voz": {
    "texto": "Un sabio pidió como premio un grano de trigo. Y el rey no pudo pagarle."
   },
   "dur": 6.6,
   "palabrasClave": [
    "grano de trigo"
   ]
  },
  {
   "id": "e2",
   "tipo": "manuscrito",
   "params": {
    "titular": "Cuenta la leyenda",
    "destacado": "de la India.",
    "estilo": "pergamino",
    "encabezado": "La recompensa de Sessa",
    "lineas": [
     {
      "texto": "Un grano en la primera casilla,"
     },
     {
      "texto": "dos en la segunda,"
     },
     {
      "texto": "cuatro en la tercera..."
     },
     {
      "texto": "y así, duplicando,",
      "subraya": "si"
     },
     {
      "texto": "hasta la casilla 64.",
      "subraya": "si"
     }
    ],
    "autor": "Leyenda registrada por Ibn Jalikán en 1256"
   },
   "voz": {
    "texto": "Cuenta la leyenda que Sessa, el inventor del ajedrez, pidió un grano en la primera casilla, dos en la segunda, cuatro en la tercera, y así, duplicando, hasta la sesenta y cuatro. El rey se rió de lo poco que pedía."
   },
   "dur": 11,
   "palabrasClave": [
    "duplicando"
   ]
  },
  {
   "id": "e3",
   "tipo": "tablero",
   "params": {
    "titular": "Al principio,",
    "destacado": "parece nada.",
    "desdeCasilla": 1,
    "casilla": 6,
    "dato": "32",
    "datoEtiqueta": "granos en la casilla 6",
    "bajada": "Cada casilla *duplica* a la anterior."
   },
   "voz": {
    "texto": "Al principio parece nada: uno, dos, cuatro, ocho, dieciséis, treinta y dos granos."
   },
   "dur": 5.75,
   "palabrasClave": [
    "parece nada"
   ]
  },
  {
   "id": "e4",
   "tipo": "tablero",
   "params": {
    "titular": "En la casilla 20",
    "destacado": "ya son",
    "desdeCasilla": 7,
    "casilla": 20,
    "dato": "524.288",
    "datoEtiqueta": "granos de trigo",
    "bajada": "Entre *14 y 27 kg*, según el peso del grano."
   },
   "voz": {
    "texto": "En la casilla veinte ya son más de quinientos mil granos: entre catorce y veintisiete kilos de trigo."
   },
   "dur": 7,
   "palabrasClave": [
    "kilos de trigo"
   ]
  },
  {
   "id": "e5",
   "tipo": "tablero",
   "params": {
    "titular": "En la casilla 32,",
    "destacado": "la mitad del tablero",
    "desdeCasilla": 21,
    "casilla": 32,
    "dato": "2.147",
    "datoEtiqueta": "millones de granos de trigo",
    "bajada": "Entre *57 y 109 toneladas*."
   },
   "voz": {
    "texto": "En la treinta y dos, la mitad del tablero, más de dos mil millones de granos: entre cincuenta y siete y ciento nueve toneladas."
   },
   "dur": 7,
   "palabrasClave": [
    "la mitad",
    "toneladas"
   ]
  },
  {
   "id": "e6",
   "tipo": "tablero",
   "params": {
    "titular": "Y el tablero completo:",
    "destacado": "unos 18 trillones",
    "desdeCasilla": 33,
    "casilla": 64,
    "dato": "18,4",
    "datoEtiqueta": "trillones de granos de trigo",
    "bajada": "`2^64 - 1` = 18.446.744.073.709.551.615"
   },
   "voz": {
    "texto": "Y el tablero completo: dos elevado a sesenta y cuatro, menos uno. Más de dieciocho trillones de granos."
   },
   "dur": 7,
   "palabrasClave": [
    "trillones"
   ]
  },
  {
   "id": "e7",
   "tipo": "contador",
   "params": {
    "sello": "Cosecha mundial",
    "titular": "Para juntarlo",
    "destacado": "no alcanza el planeta.",
    "hasta": 600,
    "desde": 0,
    "decimales": 0,
    "prefijo": "+",
    "sufijo": " años",
    "etiqueta": "de toda la cosecha mundial de trigo",
    "detalle": "Entre *600 y 1.150 años*, con la producción 2026 de la FAO."
   },
   "voz": {
    "texto": "Para juntarlo habría que guardar toda la cosecha mundial de trigo durante seiscientos a mil ciento cincuenta años."
   },
   "dur": 6.85,
   "palabrasClave": [
    "cosecha mundial"
   ]
  },
  {
   "id": "e8",
   "tipo": "mitoRealidad",
   "params": {
    "titular": "Ojo con",
    "destacado": "los números grandes.",
    "pares": [
     {
      "mito": "Son 18,4 «quintillones» de granos.",
      "realidad": "En español son *18 trillones*. Y un trillón es `10^18`."
     }
    ]
   },
   "voz": {
    "texto": "Y ojo: si lees dieciocho quintillones, es una mala traducción del inglés. En español son dieciocho trillones."
   },
   "dur": 8,
   "palabrasClave": [
    "mala traducción"
   ]
  },
  {
   "id": "e9",
   "tipo": "desafio",
   "params": {
    "titular": "Ahora tú.",
    "etiqueta": "Desafío estilo PAES · M1",
    "enunciado": "Si pones 1 grano en la primera casilla y duplicas en cada una, ¿cuántos granos hay en total en las primeras *10 casillas*?",
    "alternativas": [
     "512",
     "1.023",
     "1.024",
     "2.047"
    ],
    "segundos": 3,
    "pie": "Responde en los comentarios"
   },
   "voz": {
    "texto": "Ahora tú: ¿cuántos granos hay en total en las primeras diez casillas? Tres segundos."
   },
   "dur": 8.4,
   "palabrasClave": [
    "Ahora tú"
   ]
  },
  {
   "id": "e10",
   "tipo": "respuesta",
   "params": {
    "titular": "Respuesta: B.",
    "alternativas": [
     {
      "texto": "512",
      "porque": "`2^9`: es solo la casilla 10"
     },
     {
      "texto": "1.023",
      "porque": "`1 + 2 + ... + 2^9 = 2^10 - 1`"
     },
     {
      "texto": "1.024",
      "porque": "`2^10`: se pasa por uno"
     },
     {
      "texto": "2.047",
      "porque": "`2^11 - 1`: serían 11 casillas"
     }
    ],
    "correcta": "B",
    "explicacion": "Sumar casillas que se duplican da `2^n - 1`."
   },
   "voz": {
    "texto": "La B: mil veintitrés. Sumar casillas que se duplican da dos elevado a n, menos uno."
   },
   "dur": 7.1,
   "palabrasClave": [
    "La B",
    "menos uno"
   ]
  },
  {
   "id": "e11",
   "tipo": "cierre",
   "params": {
    "titular": "Guárdalo y",
    "destacado": "compártelo",
    "bajada": "con quien da la *PAES*.",
    "accion": "guardar",
    "llamado": "Comenta",
    "clave": "AJEDREZ"
   },
   "voz": {
    "texto": "Guárdalo y compártelo con quien da la PAES."
   },
   "dur": 4,
   "palabrasClave": [
    "la PAES"
   ]
  }
